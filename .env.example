# ===== ashare-mcp configuration =====
# Copy to .env and adjust. All values are optional; sensible defaults apply.

# Tushare token. Leave empty to disable the tushare fallback.
# Get one free at https://tushare.pro/user/token
TUSHARE_TOKEN=

# Directory for the SQLite cache + log files. Default: ~/.ashare-mcp
CACHE_DIR=

# Log level: DEBUG | INFO | WARNING | ERROR. Default: INFO
LOG_LEVEL=INFO

# Bearer token required by the HTTP transport (header: Authorization: Bearer <token>).
# Leave empty to disable auth. STRONGLY recommended to set this when exposing publicly.
MCP_AUTH_TOKEN=

# Default max rows returned by "ranking / full-market" style tools. Default: 50
DEFAULT_LIMIT=50
